# Docker environment variables for local development
#
# Copy this file to .docker/docker.env and adjust ports as needed.
# The docker.env file is gitignored, your overrides won't affect other developers.
#
# Default values (matching docker-compose.yml defaults) allow single-project use
# without any changes. Override ports when running multiple projects simultaneously.
#
# --- Port offset formula (deterministic per project) ---
#
# To generate unique ports for a project, run from the project root:
#
#   offset=$(printf '%s' "$(basename "$PWD")" | cksum | cut -d' ' -f1)
#   offset=$((offset % 100))
#   echo "NGINX_HTTP_PORT=$((4000 + offset))"
#   echo "NGINX_HTTPS_PORT=$((4400 + offset))"
#   echo "MAILHOG_SMTP_PORT=$((10250 + offset))"
#   echo "MAILHOG_WEB_PORT=$((8200 + offset))"
#
# When NGINX_HTTP_PORT or NGINX_HTTPS_PORT differs from the defaults (80/443),
# update WP_HOME in .env to include the port, e.g.:
#   WP_HOME=https://omakeikka.local.dev:<NGINX_HTTPS_PORT>
#
# --- Fallback rule when a computed port still conflicts ---
#
# If `ss -tln | grep :<port>` shows the computed port is occupied (e.g. another
# stack uses the same offset), bump that single port by +100 increments until
# free. Keep the other ports on the original offset so the suite stays grouped
# in a predictable range.
#
#   port=4089
#   while ss -tln | grep -q ":$port "; do port=$((port + 100)); done
#   echo "NGINX_HTTP_PORT=$port"
#

NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
MAILHOG_SMTP_PORT=1025
MAILHOG_WEB_PORT=8025
